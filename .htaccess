# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
# index.php reads ENVIRONMENT from $_SERVER['CI_ENV'] and falls back to
# 'development' when it is absent. APP_ENV in .env does NOT affect this —
# .env is loaded nine lines later, so it cannot influence the constant.
#
# Host-matched so one committed file serves both environments: the live host
# gets 'production' (errors hidden, and Paddle/registrar API calls verify SSL
# certificates); localhost and any staging host fall through to development.
SetEnvIf Host ^my\.whmaz\.com$ CI_ENV=production

# Enable mod_rewrite
RewriteEngine On

# Prevent direct access to sensitive files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L]

# ============================================================================
# SECURITY HEADERS
# ============================================================================

# Prevent clickjacking attacks by restricting how the site can be framed
Header set X-Frame-Options "SAMEORIGIN"

# Prevent MIME type sniffing (attacks via content-type confusion)
Header set X-Content-Type-Options "nosniff"

# XSS Protection for older browsers
Header set X-XSS-Protection "1; mode=block"

# Control what referrer information is shared
Header set Referrer-Policy "strict-origin-when-cross-origin"

# Content Security Policy - Restrict resource loading
# Allows content only from same origin for scripts/styles, images from any https source
# Google reCAPTCHA requires: www.google.com, www.gstatic.com
# Google Fonts requires: fonts.googleapis.com (CSS), fonts.gstatic.com (font files)
# Payment Gateways: Stripe, PayPal, Razorpay, Paystack, SSLCommerz, Paddle (paddle.js overlay)
#
# ⚠️ KEEP THIS IN SYNC WITH src/config/config.php (~line 636). Both set a CSP;
# under LiteSpeed this header wins over PHP's header() call, so a domain added
# only to config.php is silently NOT enforced — which is how cdn.paddle.com
# came to be blocked on live while config.php looked correct.
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://js.stripe.com https://www.paypal.com https://www.sandbox.paypal.com https://checkout.razorpay.com https://js.paystack.co https://cdn.paddle.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://www.google.com https://api.stripe.com https://www.paypal.com https://www.sandbox.paypal.com https://api.razorpay.com https://api.paystack.co https://cdn.paddle.com https://api.paddle.com https://sandbox-api.paddle.com https://checkout-service.paddle.com https://sandbox-checkout-service.paddle.com; frame-src 'self' https://www.google.com https://js.stripe.com https://www.paypal.com https://www.sandbox.paypal.com https://api.razorpay.com https://checkout.razorpay.com https://buy.paddle.com https://sandbox-buy.paddle.com https://cdn.paddle.com; frame-ancestors 'self'"

# Enforce HTTPS in production (uncomment when using HTTPS)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================================
# ADDITIONAL SECURITY
# ============================================================================

# Disable directory listing
Options -Indexes

# Prevent access to sensitive files
<Files ~ "^\.(env|git|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Protect configuration files
<FilesMatch "^(config|database|composer)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>